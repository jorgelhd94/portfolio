---
import { getLocale, ui } from '../i18n/ui';
import { languageLinks } from '../i18n/routes';
import { Font } from 'astro:assets';
import ContextMenu from '../components/nav/ContextMenu';
import { getSocialLinks } from '../data/site';
import { cv } from '../data/about';

import { withBase } from '../lib/base';

import '../styles/global.css';

interface Props {
	title: string;
	previewTitle?: string;
	description?: string;
}

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const { title, previewTitle = title, description = t.description } = Astro.props;
const alternates = languageLinks(Astro.url.pathname);

const canonical = new URL(alternates[locale], Astro.site);
const preview = new URL(withBase('/og.jpg'), Astro.site);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={withBase('/favicon.ico?v=2')} sizes="16x16 32x32 48x48 64x64 128x128 256x256" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg?v=2')} sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{Object.entries(alternates).map(([lang, path]) => <link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />
		<meta property="og:locale" content={locale === 'es' ? 'es_UY' : 'en_US'} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jorge Hernández" />
		<meta property="og:title" content={previewTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{/* Scrapers do not follow relative URLs, and several never fetch WebP. */}
		<meta property="og:image" content={preview} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`Jorge Hernández — ${t.role}, Montevideo`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={previewTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={preview} />

		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-display" preload />
	</head>
	<body>
		<slot />
		<ContextMenu client:load locale={locale} social={getSocialLinks(locale)} cv={cv} />
	</body>
</html>
