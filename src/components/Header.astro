---
import ContributionText from './ContributionText.tsx';
import HeaderBackground from './HeaderBackground.astro';
import Nav from './Nav.astro';
---

<header id="top" class="relative isolate flex min-h-dvh flex-col overflow-hidden">
	<HeaderBackground />

	<Nav />

	<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-6 pb-48">
		<h1 class="sr-only">Software Engineer</h1>

		<div class="reveal" style="--delay: 0.2s" aria-hidden="true">
			<ContributionText client:load lines={['SOFTWARE', 'ENGINEER']} trailingMark="." />
		</div>
	</div>

	<div class="pointer-events-none absolute inset-x-0 bottom-8 flex justify-center">
		<span class="scroll-cue h-12 w-px bg-linear-to-b from-transparent via-mist-500 to-transparent"
		></span>
	</div>
</header>

<style>
	/* Staggered entrance: content rises into place. `backwards` holds the initial
	   state during the delay so nothing flashes first. Each element sets its own
	   `--delay`, which survives reordering the hero. */
	.reveal {
		animation: reveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
		animation-delay: var(--delay, 0s);
	}

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translate3d(0, 1.5rem, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	.scroll-cue {
		animation: scroll-cue 2.6s ease-in-out infinite;
	}

	@keyframes scroll-cue {
		0%,
		100% {
			opacity: 0.25;
			transform: scaleY(0.6);
		}
		50% {
			opacity: 0.8;
			transform: scaleY(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.scroll-cue {
			animation: none;
		}
	}
</style>
