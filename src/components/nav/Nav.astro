---
import { getNavLinks, getSocialLinks } from '../../data/site';
import { getLocale, ui } from '../../i18n/ui';
import { languageLinks } from '../../i18n/routes';
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const navLinks = getNavLinks(locale);
const social = getSocialLinks(locale);
const languages = languageLinks(Astro.url.pathname);
import { localePath } from '../../i18n/routes';
import NavPill from './NavPill.tsx';
import QuickMenu from './QuickMenu.tsx';
---

{/* Equal-width rails on both sides. `justify-between` centres the pill between
	its neighbours rather than in the bar, drifting by half the difference
	between the wordmark's width and the button's. */}
<nav class="mx-auto flex w-full max-w-6xl items-center gap-6 px-6 py-6">
	<div class="flex flex-1 justify-start">
		<a
			href={localePath(locale)}
			class="font-wordmark text-[2.25rem] leading-none font-bold whitespace-nowrap text-mist-100 transition-colors duration-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-clay-400"
		>
			Jorge H.
		</a>
	</div>

	<NavPill greeting={t.welcome} client:media="(min-width: 1024px)" links={navLinks} />

	<div class="flex flex-1 justify-end">
		<QuickMenu locale={locale} languages={languages} client:load links={navLinks} social={social} />
	</div>
</nav>
