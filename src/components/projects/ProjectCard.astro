---
import { getLocale, ui } from '../../i18n/ui';
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
import Grain from '../visuals/Grain.astro';
import { Image } from 'astro:assets';
import type { Project } from '../../data/projects';
import { getProjectImage } from '../../data/projectImages';
import { TECH } from '../../data/tech';
import { localePath } from '../../i18n/routes';
import TechIcon from '../TechIcon.astro';
import WaveButton from '../WaveButton.astro';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const shot = getProjectImage(project.slug);
---

<article
	class="card overflow-hidden rounded-3xl border border-white/[0.08]"
	data-stack-card
	style={`--i: ${index}; --mx: ${project.spill.x}; --my: ${project.spill.y}`}
>
	<div class="media relative overflow-hidden">
		<span class="spill" aria-hidden="true" />

		{shot ? (
			<Image
				src={shot}
				alt={`${project.name} — ${t.interface}`}
				widths={[480, 800, 1200]}
				sizes="(min-width: 768px) 45vw, 92vw"
				class="shot"
				style={`view-transition-name: shot-${project.slug}`}
			/>
		) : (
			<span class="mark font-wordmark" aria-hidden="true">
				{project.name.charAt(0)}
			</span>
		)}

		<Grain opacity={0.13} />

		<a
			class="stretch"
			href={localePath(locale, `/projects/${project.slug}`)}
			tabindex="-1"
			aria-hidden="true"
		/>
	</div>

	<div class="body flex min-w-0 flex-col justify-center gap-4 p-6 md:gap-6 md:p-12">
		<p class="meta border-b border-white/[0.07] pb-4 text-[0.72rem] font-medium tracking-[0.18em] text-mist-300 uppercase">
			{project.kind}
		</p>

		<h3 class="name">{project.name}</h3>

		<p class="blurb hidden text-base leading-relaxed text-mist-300 md:block">{project.blurb}</p>

		<ul class="flex flex-wrap items-center gap-2">
			{project.tech.map((tech) => (
				<li class="chip flex size-10 items-center justify-center rounded-xl border border-white/[0.06] bg-white/[0.03] text-mist-300">
					<TechIcon name={tech} />
					<span class="tip">{TECH[tech].label}</span>
				</li>
			))}
		</ul>

		<div class="actions mt-1 flex flex-nowrap items-center gap-2.5">
			<WaveButton href={localePath(locale, `/projects/${project.slug}`)} label={t.details} primary />

			<WaveButton href={project.href} label={project.linkLabel} external>
				<svg
					slot="icon"
					viewBox="0 0 24 24"
					class="size-3.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M8 16 16 8m-6.5-.5H16.5v7" />
				</svg>
			</WaveButton>
		</div>
	</div>
</article>

<style>
	.card {
		--stick: calc(var(--base) + var(--i) * var(--step));
		position: sticky;
		top: var(--stick);
		display: grid;

		grid-template-rows: minmax(9rem, auto) 1fr;

		background: var(--color-ink-900);
		/* Shrinking from the top edge is what holds each buried card's peek in
		   place: with a centred origin the stair would drift as it scaled. */
		transform-origin: 50% 0;
	}

	/* The gap in normal flow is the scroll it takes the next card to arrive;
	   around a viewport per card keeps one handoff on screen at a time. */
	.card + .card {
		margin-top: 12vh;
	}

	/* The recede is a dim, not an opacity fade: the card must stay opaque or the
	   pile behind it would show through the content. */
	.card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		background: var(--color-ink-950);
		opacity: calc(var(--veil, 0) * 0.6);
		pointer-events: none;
	}

	@media (min-width: 768px) {
		.card {
			grid-template-rows: none;
			grid-template-columns: 1.05fr 1fr;
			align-items: stretch;

			height: min(30rem, calc(100dvh - var(--stick) - 3.5rem));
		}
	}

	.shot {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: auto;

		max-height: 13rem;
		object-fit: cover;
		object-position: top;
	}

	@media (min-width: 768px) {
		.shot {
			position: absolute;
			top: 50%;
			left: 1.25rem;
			width: calc(100% - 2.5rem);
			translate: 0 -50%;
			/* Released, so the box goes back to the capture's own ratio and there is
			   nothing left for `cover` to trim. */
			max-height: none;
			border: 1px solid rgba(255, 255, 255, 0.09);
			border-radius: 0.7rem;
			box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.95);
		}
	}

	.name {
		font-size: clamp(1.55rem, 2.6vw, 2.35rem);
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.12;
	}

	.chip {
		position: relative;
		transition:
			color 300ms,
			border-color 300ms;
	}

	/* Above the veil, which sits at 2 and would otherwise wash the label out on a
	   card that is only part-way receded. */
	.tip {
		position: absolute;
		bottom: calc(100% + 0.45rem);
		left: 50%;
		z-index: 3;
		translate: -50% 4px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.6rem;
		background: var(--color-ink-800);
		box-shadow: 0 8px 20px -12px rgba(0, 0, 0, 0.9);
		padding: 0.3rem 0.55rem;
		font-size: 0.7rem;
		white-space: nowrap;
		color: var(--color-mist-100);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 200ms linear,
			translate 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.chip:hover .tip {
		opacity: 1;
		translate: -50% 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.tip {
			translate: -50% 0;
		}
	}

	.chip:hover {
		color: var(--color-mist-100);
		border-color: rgba(255, 255, 255, 0.18);
	}

	.chip :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
		transition: color 300ms;
	}

	/* Same reward as the stack tiles: the mark takes its brand colour under the
	   pointer, so the two sections read as one system. */
	.chip:hover :global(svg) {
		color: var(--brand);
	}

	.stretch {
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.actions :global(.wave-button) {
		min-width: 0;
		padding: 0 0.7rem;
	}

	@media (min-width: 768px) {
		.actions :global(.wave-button) {
			padding: 0 1.25rem;
		}
	}

	/* Placeholder art in the palette's terms: a neutral graphite surface with a
	   clay light falling across it — never a clay surface. */
	.media {
		background:
			radial-gradient(120% 90% at 30% 20%, rgba(190, 190, 190, 0.08), transparent 55%),
			linear-gradient(140deg, #1d1d1d 0%, #161616 45%, #101010 100%);
	}

	.spill {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			70% 65% at var(--mx) var(--my),
			rgba(223, 174, 139, 0.22),
			rgba(199, 141, 104, 0.07) 45%,
			transparent 75%
		);
	}

	.mark {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: clamp(9rem, 24vw, 17rem);
		line-height: 1;
		color: rgba(255, 255, 255, 0.05);
		user-select: none;
	}


</style>
