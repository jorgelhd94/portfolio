---
import NavPill from './NavPill.tsx';
import QuickMenu from './QuickMenu.tsx';

const links = [
	{ label: 'Home', href: '#top' },
	{ label: 'About Me', href: '#about' },
	{ label: 'Projects', href: '#projects' },
	{ label: 'Stack', href: '#stack' },
	{ label: 'Contact', href: '#contact' },
];

// TODO: swap in the real profiles.
const social = [
	{ label: 'GitHub', href: 'https://github.com', icon: 'github' as const },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com', icon: 'linkedin' as const },
	{ label: 'Mail', href: 'mailto:jorgelhd94@gmail.com', icon: 'mail' as const },
];
---

<nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-6 py-6">
	<a
		href="/"
		class="font-wordmark text-[2.25rem] leading-none font-bold text-mist-100 transition-colors duration-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-azure-400"
	>
		Jorge Hernández
	</a>

	<NavPill client:load links={links} />

	<QuickMenu client:load links={links} social={social} />
</nav>
