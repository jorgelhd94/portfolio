---
import { getLocale, ui } from '../i18n/ui';
import { localePath } from '../i18n/routes';
import LanguageSwitcher from '../components/nav/LanguageSwitcher.astro';
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
import Layout from '../layouts/Layout.astro';
import WaveButton from '../components/WaveButton.astro';
---

<Layout
	title={`${t.notFound} — Jorge Hernández`}
	previewTitle={t.notFound}
	description={`${t.notFound} ${t.backPortfolio}`}
>
	<main class="flex min-h-svh flex-col items-center justify-center gap-7 px-6 text-center">
		<p class="code" aria-hidden="true">404</p>

		<div>
			<h1 class="text-3xl font-semibold tracking-[-0.02em] md:text-4xl">
				{t.notFound}
			</h1>
			<p class="mt-3 text-mist-500">
				{t.notFoundHint}
			</p>
		</div>

		<WaveButton href={localePath(locale)} label={t.backPortfolio} primary />
		<LanguageSwitcher />
	</main>
</Layout>

<style>
	/* The closing wordmark's light, at the size of a page number: lit at the top
	   and falling away, so the page still sounds like the rest of the site. */
	.code {
		background: linear-gradient(180deg, #dfae8b 0%, #c78d68 58%, #a9714f 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: clamp(5rem, 18vw, 11rem);
		font-weight: 900;
		letter-spacing: -0.04em;
		line-height: 1;
		opacity: 0.22;
		user-select: none;
	}
</style>
