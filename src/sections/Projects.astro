---
import { getLocale, ui } from '../i18n/ui';
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
import { getProjects } from '../data/projects';
const projects = getProjects(locale);
import ProjectCard from '../components/projects/ProjectCard.astro';
---

<section id="projects" class="section relative px-6 pt-6 pb-2 md:pt-8 md:pb-4">
	<div class="mx-auto w-full max-w-6xl">
		<header class="mb-10 text-center md:mb-14">
			<h2 class="title">{t.projectsTitle}</h2>
			<p class="lead mx-auto mt-5 max-w-xl">
				{t.projectsLead}
			</p>
		</header>

		<div class="deck">
			{
				projects.map((project, index) => (
					<ProjectCard project={project} index={index} />
				))
			}
		</div>
	</div>
</section>

<style>

	.section {
		background: linear-gradient(180deg, var(--color-ink-950) 0%, #0d0d0d 22%, #0d0d0d 100%);
	}

	.title {
		font-size: clamp(2.1rem, 4.5vw, 3.3rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.08;
	}

	.lead {
		color: var(--color-mist-500);
		font-size: 1rem;
	}

	/* Where the first card pins, and how far below it each later card rests. */
	.deck {
		--base: 3.5rem;
		--step: 0.7rem;
	}

	@media (min-width: 768px) {
		.deck {
			--base: 5.5rem;
			--step: 0.85rem;
		}

	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-card]'));

	gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
		cards.forEach((card, index) => {
			const next = cards[index + 1];
			if (!next) return;

			gsap.to(card, {
				scale: 0.94,
				'--veil': 1,
				ease: 'none',
				scrollTrigger: {
					trigger: next,
					start: 'top bottom',
					// Done receding exactly when the next card reaches its own resting
					// top — read live because the stair gives every card a different one.
					end: () => `top ${Math.round(parseFloat(getComputedStyle(next).top))}`,
					scrub: true,
					invalidateOnRefresh: true,
				},
			});
		});
	});
</script>
