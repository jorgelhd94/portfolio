---
import { github } from '../data/site';
import ContributionText from '../components/visuals/ContributionText.tsx';
import HeaderBackground from './HeaderBackground.astro';
import Nav from '../components/nav/Nav.astro';
---

{/* Pinned by ScrollTrigger, which holds it on screen while the scroll drives the
animation instead of the layout. */}
<header id="top" class="hero-stage isolate flex h-dvh flex-col overflow-hidden">
	<HeaderBackground />

		<div class="nav-shell">
			<Nav />
		</div>

		<div
			class="mx-auto flex w-full max-w-6xl flex-1 flex-col items-center justify-center px-6 pb-32"
		>
		<h1 class="sr-only">Software Engineer</h1>

		<div class="reveal w-full" style="--delay: 0.2s" aria-hidden="true">
			<ContributionText client:load lines={['SOFTWARE', 'ENGINEER']} />
		</div>

		{/* Phones only. The headline scales to its container, so on a narrow screen
		it lands as a band and leaves the viewport half empty; from md up the graph
		fills the screen on its own and the scroll hint is enough. */}
		<div
			class="actions reveal mt-10 flex w-full max-w-[19rem] items-center gap-2.5 md:hidden"
			style="--delay: 0.7s"
		>
			<a href="#projects" class="wave-button wave-button-primary flex-1">
				<span class="wave-fill" aria-hidden="true"></span>
				<span class="wave-face">View projects</span>
				<span class="wave-face wave-face-inverted" aria-hidden="true">View projects</span>
			</a>

			<a
				href={github}
				target="_blank"
				rel="noreferrer"
				class="wave-button flex-none"
			>
				<span class="wave-fill" aria-hidden="true"></span>
				<span class="wave-face">
					<svg viewBox="0 0 24 24" class="size-[17px]" aria-hidden="true">
						<path
							fill="currentColor"
							d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
						></path>
					</svg>
					GitHub
				</span>
				<span class="wave-face wave-face-inverted" aria-hidden="true">
					<svg viewBox="0 0 24 24" class="size-[17px]" aria-hidden="true">
						<path
							fill="currentColor"
							d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
						></path>
					</svg>
					GitHub
				</span>
			</a>
		</div>
	</div>

	{/* The cue is the control: it says the page continues and it takes you there,
	so the affordance and the signal are one object. */}
	<div
		class="reveal pointer-events-none absolute inset-x-0 bottom-12 flex justify-center"
		style="--delay: 1.2s"
	>
		<a
			href="#learning"
			aria-label="Scroll to what comes next"
			class="hint pointer-events-auto flex flex-col items-center gap-4 rounded-lg px-5 py-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-clay-400"
		>
			<span
				class="hint-label text-[0.7rem] font-medium tracking-[0.3em] text-mist-500 uppercase transition-colors duration-300"
				>Scroll</span
			>
			<span class="scroll-track"><span class="scroll-spark"></span></span>
		</a>
	</div>

</header>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const panel = document.querySelector<HTMLElement>('.hero-stage');

	if (panel) {
		/** Where the screen starts to go, and how much of the pin the going takes. */
		const HOLD = 0.5;
		const FADE = 0.3;

		const ramp = (value: number, from: number, over: number) =>
			Math.min(1, Math.max(0, (value - from) / over));

		gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
			ScrollTrigger.create({
				trigger: panel,
				start: 'top top',
				end: '+=180%',
				pin: true,
				// No spacer: the section below keeps its place in the scroll and is
				// pinned behind this one from the start, so it is already where it
				// belongs long before this clears off it. Reserving space instead
				// would make it arrive only once the pin ended.
				pinSpacing: false,
				onUpdate: (self) => {
					const p = self.progress;
					const exit = ramp(p, HOLD, FADE);

					panel.style.setProperty('--cue', ramp(p, 0, 0.14).toFixed(3));
					panel.style.setProperty('--early', ramp(p, 0.06, 0.34).toFixed(3));
					panel.style.setProperty('--dissolve', ramp(p, 0, 0.46).toFixed(3));
					panel.style.setProperty('--exit', exit.toFixed(3));

					// Cleared, it is still a pinned full-screen panel over the section
					// below, and it would swallow every click meant for it.
					panel.style.pointerEvents = exit >= 1 ? 'none' : '';
				},
			});
		});
	}
</script>

<style>
	/* Staggered entrance: content rises into place. `backwards` holds the initial
	   state during the delay so nothing flashes first. Each element sets its own
	   `--delay`, which survives reordering the hero. */
	.reveal {
		animation: reveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
		animation-delay: var(--delay, 0s);
	}

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translate3d(0, 1.5rem, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	/* Stays above the section that is pinned behind it, and clears as a whole —
	   background, wordmark, nav and all — so what is uncovered is that section
	   rather than a hero with pieces left standing on it.

	   The dissolve starts declared so the headline has a value to read before the
	   pin has ever updated. */
	.hero-stage {
		position: relative;
		z-index: 1;
		--dissolve: 0;
		opacity: calc(1 - var(--exit, 0));
	}

	.hint:hover .hint-label {
		color: var(--color-mist-100);
	}

	.hint:hover .scroll-track {
		background: linear-gradient(
			to bottom,
			rgba(190, 175, 160, 0.75),
			rgba(190, 175, 160, 0.75) 60%,
			transparent
		);
	}

	/* Everything on the hero leaves on one of two beats, both read from the same
	   stage progress the words are. The cue goes as soon as the page moves, since
	   by then it has said what it had to; the wordmark, the nav and the actions go
	   with the words, so the screen is never a bare navigation bar over an empty
	   panel waiting for the handoff. */
	.hint {
		opacity: calc(1 - var(--cue, 0));
	}

	.nav-shell,
	.actions {
		opacity: calc(1 - var(--early, 0));
	}

	/* The wave that hands the headline from green to white sweeps these on hover,
	   same direction and same easing.

	   The label is rendered twice — light underneath, dark on top — with the dark
	   copy clipped by that same wave, so it inverts exactly as the light reaches
	   it. `mix-blend-mode: difference` would do this in one element, but over
	   graphite it gives muddy colour and wrecks subpixel antialiasing. */
	.wave-button {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 9999px;
		border: 1px solid var(--edge, rgba(255, 255, 255, 0.1));
		background: rgba(255, 255, 255, 0.035);
		/* Height from min-height rather than vertical padding, so the icon-only
		   variant can drop its padding and still line up with the labelled one. */
		min-height: 2.6rem;
		padding: 0 1.25rem;
		font-size: 0.8rem;
		font-weight: 500;
		transition: border-color 320ms ease;
	}

	.wave-button:hover,
	.wave-button:focus-visible {
		border-color: rgba(255, 255, 255, 0.28);
	}

	.wave-button:focus-visible {
		outline: 2px solid var(--color-clay-400);
		outline-offset: 2px;
	}

	.wave-button-primary {
		--edge: rgba(255, 255, 255, 0.2);
	}

	.wave-button-primary::after {
		content: '';
		position: absolute;
		top: 0;
		right: 24%;
		left: 24%;
		z-index: 1;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 240, 226, 0.9), transparent);
	}

	/* The crest rides the right edge, which is the leading edge as the clip opens. */
	.wave-fill {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, #dcdcdc 0%, #efefef 78%, #ffffff 100%);
		clip-path: inset(0 100% 0 0);
		transition: clip-path 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.wave-face {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		white-space: nowrap;
		color: var(--color-mist-300);
	}

	/* Both copies of the label carry .wave-face, so this must not reach the
	   inverted one: it outweighs `.wave-face-inverted` and would paint the dark
	   copy white — invisible over the white fill it is clipped to. */
	.wave-button-primary .wave-face:not(.wave-face-inverted) {
		color: #fff;
	}

	.wave-face-inverted {
		position: absolute;
		inset: 0;
		color: var(--color-ink-950);
		clip-path: inset(0 100% 0 0);
		transition: clip-path 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.wave-button:hover .wave-fill,
	.wave-button:hover .wave-face-inverted,
	.wave-button:focus-visible .wave-fill,
	.wave-button:focus-visible .wave-face-inverted {
		clip-path: inset(0 0 0 0);
	}

	/* The track stays lit so there is something to read while the spark is off
	   screen; a cue that vanishes between passes reads as a rendering glitch. */
	.scroll-track {
		position: relative;
		display: block;
		height: 3.25rem;
		width: 1px;
		overflow: hidden;
		background: linear-gradient(
			to bottom,
			rgba(140, 140, 140, 0.55),
			rgba(140, 140, 140, 0.55) 60%,
			transparent
		);
	}

	.scroll-spark {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 45%;
		background: linear-gradient(to bottom, transparent, rgba(255, 240, 226, 0.9), transparent);
		animation: scroll-spark 2.6s cubic-bezier(0.55, 0, 0.45, 1) infinite;
	}

	@keyframes scroll-spark {
		0% {
			transform: translateY(-100%);
			opacity: 0;
		}
		25% {
			opacity: 1;
		}
		70% {
			opacity: 1;
		}
		100% {
			transform: translateY(230%);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			animation: none;
		}

		.scroll-spark {
			animation: none;
			opacity: 0.6;
		}

		.wave-fill,
		.wave-face-inverted {
			transition: none;
		}
	}
</style>
