---
import { github } from '../data/site';
import SocialIcon from '../components/SocialIcon.astro';
import ContributionText from '../components/visuals/ContributionText.tsx';
import HeaderBackground from './HeaderBackground.astro';
import Nav from '../components/nav/Nav.astro';
import WaveButton from '../components/WaveButton.astro';
---

{/* Pinned by ScrollTrigger, which holds it on screen while the scroll drives the
animation instead of the layout. */}
<header id="top" class="hero-stage isolate flex h-lvh flex-col overflow-hidden">
	<HeaderBackground />

	<div class="nav-shell">
		<Nav />
	</div>

	<div
		class="mx-auto flex w-full max-w-6xl flex-1 flex-col items-center justify-center px-6 pb-32"
	>
		<h1 class="sr-only">Software Engineer</h1>

		<div class="reveal w-full" style="--delay: 0.2s" aria-hidden="true">
			<ContributionText client:load lines={['SOFTWARE', 'ENGINEER']} />
		</div>

		{/* Phones only. The headline scales to its container, so on a narrow screen
		it lands as a band and leaves the viewport half empty; from md up the graph
		fills the screen on its own and the scroll hint is enough. */}
		<div
			class="actions reveal mt-10 flex w-full max-w-[19rem] items-center gap-2.5 md:hidden"
			style="--delay: 0.7s"
		>
			<WaveButton href="#projects" label="View projects" primary class="flex-1" />

			<WaveButton href={github} label="GitHub" external class="flex-none">
				<SocialIcon slot="icon" name="github" class="size-[17px]" />
			</WaveButton>
		</div>
	</div>

	{/* The cue is the control: it says the page continues and it takes you there,
	so the affordance and the signal are one object. */}
	<div
		class="reveal pointer-events-none absolute inset-x-0 bottom-12 flex justify-center"
		style="--delay: 1.2s"
	>
		<a
			href="#learning"
			aria-label="Scroll to what comes next"
			class="hint pointer-events-auto flex flex-col items-center gap-4 rounded-lg px-5 py-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-clay-400"
		>
			<span
				class="hint-label text-[0.7rem] font-medium tracking-[0.3em] text-mist-500 uppercase transition-colors duration-300"
				>Scroll</span
			>
			<span class="scroll-track"><span class="scroll-spark"></span></span>
		</a>
	</div>

</header>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// A phone’s address bar retracts as the reader scrolls, which the browser
	// reports as a resize. Left alone, every trigger on the page recalculates
	// mid-scroll and the sections visibly jump.
	ScrollTrigger.config({ ignoreMobileResize: true });

	const panel = document.querySelector<HTMLElement>('.hero-stage');

	if (panel) {
		/** Where the screen starts to go, and how much of the pin the going takes. */
		const HOLD = 0.5;
		const FADE = 0.3;

		const ramp = (value: number, from: number, over: number) =>
			Math.min(1, Math.max(0, (value - from) / over));

		gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
			ScrollTrigger.create({
				trigger: panel,
				start: 'top top',
				end: '+=180%',
				pin: true,
				// No spacer: the section below keeps its place in the scroll and is
				// pinned behind this one from the start, so it is already where it
				// belongs long before this clears off it. Reserving space instead
				// would make it arrive only once the pin ended.
				pinSpacing: false,
				onUpdate: (self) => {
					const p = self.progress;
					const exit = ramp(p, HOLD, FADE);

					panel.style.setProperty('--cue', ramp(p, 0, 0.14).toFixed(3));
					panel.style.setProperty('--early', ramp(p, 0.06, 0.34).toFixed(3));
					panel.style.setProperty('--dissolve', ramp(p, 0, 0.46).toFixed(3));
					panel.style.setProperty('--exit', exit.toFixed(3));

					// Cleared, it is still a pinned full-screen panel over the section
					// below, and it would swallow every click meant for it.
					panel.style.pointerEvents = exit >= 1 ? 'none' : '';
					panel.inert = exit >= 1;
				},
			});
			return () => {
				for (const name of ['--cue', '--early', '--dissolve', '--exit']) panel.style.removeProperty(name);
				panel.style.pointerEvents = '';
				panel.inert = false;
			};
		});
	}

	/**
	 * `#top` names this panel, but the pin parks it a screen and a half down the
	 * document once the reader has scrolled past — `position: relative` offset by
	 * the pin distance — so the browser's own jump to that anchor lands in the
	 * section below it. Home means the top of the page, so send it there.
	 *
	 * Delegated from `document` because the same href is on the pill, the dock and
	 * the retracting bar's wordmark, two of them inside islands that mount later.
	 */
	document.addEventListener('click', (event) => {
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		const target = event.target instanceof Element ? event.target : null;
		if (!target?.closest('a[href="#top"]')) return;

		event.preventDefault();
		window.scrollTo({
			top: 0,
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
				? 'auto'
				: 'smooth',
		});
	});
</script>

<style>
	/* Staggered entrance: content rises into place. `backwards` holds the initial
	   state during the delay so nothing flashes first. Each element sets its own
	   `--delay`, which survives reordering the hero. */

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translate3d(0, 1.5rem, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	/* Stays above the section that is pinned behind it, and clears as a whole —
	   background, wordmark, nav and all — so what is uncovered is that section
	   rather than a hero with pieces left standing on it.

	   The dissolve starts declared so the headline has a value to read before the
	   pin has ever updated. */
	.hero-stage {
		position: relative;
		z-index: 1;
		--dissolve: 0;
		opacity: calc(1 - var(--exit, 0));
	}

	.hint:hover .hint-label {
		color: var(--color-mist-100);
	}

	.hint:hover .scroll-track {
		background: linear-gradient(
			to bottom,
			rgba(190, 175, 160, 0.75),
			rgba(190, 175, 160, 0.75) 60%,
			transparent
		);
	}

	/* Everything on the hero leaves on one of two beats, both read from the same
	   stage progress the words are. The cue goes as soon as the page moves, since
	   by then it has said what it had to; the wordmark, the nav and the actions go
	   with the words, so the screen is never a bare navigation bar over an empty
	   panel waiting for the handoff. */
	.hint {
		opacity: calc(1 - var(--cue, 0));
	}

	.nav-shell,
	.actions {
		opacity: calc(1 - var(--early, 0));
	}

	/* The track stays lit so there is something to read while the spark is off
	   screen; a cue that vanishes between passes reads as a rendering glitch. */
	.scroll-track {
		position: relative;
		display: block;
		height: 3.25rem;
		width: 1px;
		overflow: hidden;
		background: linear-gradient(
			to bottom,
			rgba(140, 140, 140, 0.55),
			rgba(140, 140, 140, 0.55) 60%,
			transparent
		);
	}

	.scroll-spark {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 45%;
		background: linear-gradient(to bottom, transparent, rgba(255, 240, 226, 0.9), transparent);
	}

	@keyframes scroll-spark {
		0% {
			transform: translateY(-100%);
			opacity: 0;
		}
		25% {
			opacity: 1;
		}
		70% {
			opacity: 1;
		}
		100% {
			transform: translateY(230%);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			animation: reveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: var(--delay, 0s);
		}
		.scroll-spark { animation: scroll-spark 2.6s cubic-bezier(0.55, 0, 0.45, 1) infinite; }
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-spark {
			animation: none;
			opacity: 0.6;
		}
	}
</style>
