---
import { Image } from 'astro:assets';

import portrait from '../assets/aboutme.webp';
import { cv, education, headline, languages, location } from '../data/about';
import { social } from '../data/site';

const ICONS: Record<string, string> = {
	github:
		'M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z',
	linkedin:
		'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z',
	mail: 'M3 7.5 12 13l9-5.5M4.5 5h15a1.5 1.5 0 0 1 1.5 1.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11A1.5 1.5 0 0 1 4.5 5Z',
};

const DOT =
	'grid size-[2.1rem] shrink-0 place-items-center rounded-full border border-white/10 bg-ink-950/50 text-mist-300 backdrop-blur-lg transition-colors duration-300 hover:border-white/[0.28] hover:text-mist-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400';
---

<section id="about" class="relative overflow-hidden bg-ink-950 px-4 pt-6 pb-12 md:px-6 md:pt-8 md:pb-0">
	<div class="relative mx-auto w-full max-w-[88rem]">
		{/* One frame from `md` up: the portrait keeps its own proportions and is
		    feathered on all four edges, so the corners are page-dark and the type has
		    somewhere to stand without dimming the picture. Below that it unstacks. */}
		<div class="relative flex flex-col gap-9 md:block md:aspect-video">
			<Image
				src={portrait}
				alt="Jorge Hernández"
				widths={[600, 900, 1200]}
				sizes="(min-width: 768px) 44rem, 92vw"
				class="photo order-1 block aspect-[4/5] w-full object-cover object-[50%_10%] md:absolute md:bottom-0 md:left-1/2 md:aspect-[1102/1427] md:h-full md:w-auto md:max-w-none md:-translate-x-1/2"
			/>

			<div class="order-3 md:absolute md:top-14 md:left-10 md:w-[17rem]">
				<p class="mb-3 text-[0.8125rem] font-medium tracking-[0.2em] text-mist-500 uppercase">Education</p>
				<p class="text-[1.375rem] text-mist-100">{education.degree}</p>
				<p class="mt-1 text-[1.05rem] text-mist-500">{education.school}</p>
			</div>

			<div class="order-4 md:absolute md:top-14 md:right-24 md:w-[17rem] md:text-right">
				<p class="mb-3 text-[0.8125rem] font-medium tracking-[0.2em] text-mist-500 uppercase">Languages</p>
				{
					languages.map((language, index) => (
						<p class:list={['text-[1.375rem] text-mist-100', index > 0 && 'mt-1']}>
							{language.name} <span class="text-mist-500">— {language.level}</span>
						</p>
					))
				}
			</div>

			<h2
				class="headline order-2 max-w-[22rem] font-semibold tracking-[-0.02em] md:absolute md:bottom-28 md:left-10 md:w-[21rem]"
			>
				{headline}
			</h2>

			<a
				class="cv group order-5 inline-flex w-fit items-center gap-3 rounded-full bg-mist-100 py-2 pr-6 pl-2 text-[0.95rem] font-medium text-ink-950 transition-[background-color,box-shadow] duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-clay-400 md:absolute md:right-24 md:bottom-28"
				href={cv}
				download
			>
				<span
					class="grid size-[2.1rem] shrink-0 place-items-center rounded-full bg-ink-950 text-mist-100"
					aria-hidden="true"
				>
					<svg
						viewBox="0 0 24 24"
						class="size-[1.05rem] transition-[translate] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-0.5 motion-reduce:translate-y-0"
						fill="none"
						stroke="currentColor"
						stroke-width="1.9"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M12 4v11m-4.5-4.5L12 15l4.5-4.5M5 19.5h14" />
					</svg>
				</span>
				Download CV
			</a>

			{/* A column down the right edge on a wide screen, a plain row on a phone. */}
			<div
				class="order-6 flex items-center gap-4 md:absolute md:top-14 md:right-7 md:bottom-28 md:flex-col"
			>
				<span class="rail-text text-[0.72rem] text-mist-300">{location}</span>
				<span class="rail-line hidden w-px flex-1 md:block"></span>

				{
					social.map((item) => (
						<a
							class={DOT}
							href={item.href}
							target={item.href.startsWith('mailto:') ? undefined : '_blank'}
							rel="noreferrer"
							title={item.label}
						>
							<svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
								<path
									d={ICONS[item.icon]}
									fill={item.icon === 'mail' ? 'none' : 'currentColor'}
									stroke={item.icon === 'mail' ? 'currentColor' : undefined}
									stroke-width={item.icon === 'mail' ? 1.7 : undefined}
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span class="sr-only">{item.label}</span>
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Two masks intersected, so all four edges dissolve rather than only the sides. */
	.photo {
		-webkit-mask-image:
			linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent),
			linear-gradient(180deg, transparent, #000 7%, #000 86%, transparent);
		-webkit-mask-composite: source-in;
		mask-image:
			linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent),
			linear-gradient(180deg, transparent, #000 7%, #000 86%, transparent);
		mask-composite: intersect;
	}

	/* Fluid between a phone and a wide screen, and lifted off the picture by a
	   shadow rather than by darkening what is behind it. */
	.headline {
		font-size: clamp(1.6rem, 2.6vw, 2.125rem);
		line-height: 1.14;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
	}

	/* Clay stays a light here, never a surface: the fill is the site's near-white
	   and the accent lives only in the glow beneath it. */
	.cv {
		box-shadow: 0 18px 40px -22px rgba(237, 170, 122, 0.75);
	}

	.cv:hover {
		box-shadow: 0 22px 48px -20px rgba(237, 170, 122, 0.95);
	}

	.rail-text {
		letter-spacing: 0.14em;
	}

	@media (min-width: 768px) {
		.rail-text {
			writing-mode: vertical-rl;
		}
	}

	.rail-line {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), transparent);
	}
</style>
